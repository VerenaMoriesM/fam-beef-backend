{
  "kind": "collectionType",
  "collectionName": "career_applications",
  "info": {
    "singularName": "career-application",
    "pluralName": "career-applications",
    "displayName": "Career Application",
    "description": "Job applications submitted via the careers page"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "university": {
      "type": "string"
    },
    "graduationYear": {
      "type": "string"
    },
    "faculty": {
      "type": "string"
    },
    "department": {
      "type": "enumeration",
      "enum": [
        "digital_marketing",
        "production",
        "sales"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "reviewed",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  }
}
