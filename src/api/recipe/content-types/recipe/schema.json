{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "Recipe"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "image": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": false,
      "required": true
    },
    "time": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": true
    },
    "overview": {
      "type": "text"
    },
    "ingredientsSections": {
      "type": "component",
      "repeatable": true,
      "component": "sections.ingredients-section"
    },
    "method": {
      "type": "component",
      "repeatable": true,
      "component": "sections.method-step"
    },
    "product": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    }
  }
}
