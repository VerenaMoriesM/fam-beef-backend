{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "weight": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "image": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": false
    },
    "gallery": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": true
    },
    "featured": {
      "type": "boolean",
      "default": true
    },
    "overview": {
      "type": "text"
    },
    "ingredients": {
      "type": "json"
    },
    "checkpoints": {
      "type": "json"
    },
    "storage": {
      "type": "string"
    },
    "accordions": {
      "type": "component",
      "repeatable": true,
      "component": "sections.accordion-item"
    }
  }
}
